{
  "_note": "Kinds of storylines. link_window_days = how long after the latest stage a new report still belongs to the same story, and how long follow-up search keeps looking. Each window is a judgment prior with its reason; `newsimpact calibrate` reports observed gaps between stages so the prior can be replaced by data (rule in docs/07-coverage-and-settings.md). 'title' is the plain-English name shown to people (website, suggestions).",
  "version": "playbooks-v0.7",
  "late_report_days": 3,
  "late_report_why": "Outlets publish the same events in a different order than they happened (e.g. 'interim CEO in charge' before the resignation story). A resolved story therefore still absorbs reports of its earlier stages published within 3 days of its latest stage; later ones start a new story. 3 days covers same-week reporting across time zones (US and Australian outlets) without merging a new crisis weeks later.",
  "playbooks": [
    {
      "theme": "leadership_crisis",
      "title": "Leadership change",
      "description": "Leader under pressure (misconduct report or public apology), then departure, then succession. Stages can follow within days (e.g. a conduct report and a resignation in the same week).",
      "link_window_days": 60,
      "window_basis": "judgment prior",
      "window_why": "Interim leaders are usually named at or soon after a departure, while a permanent successor search can take months. 60 days links the departure to an interim or announced successor without merging unrelated leadership news months later. Fast sequences (pressure to resignation within a week, interim CEO the same day) are common; they stay in one story and their overlapping reactions are measured together (methodology.json overlap_trading_days).",
      "triggers": [
        "leadership_misconduct",
        "leadership_apology",
        "leadership_departure"
      ],
      "stages": [
        {
          "name": "public_pressure",
          "title": "Leader under pressure",
          "event_types": [
            "leadership_misconduct",
            "leadership_apology"
          ],
          "follow_up_terms": [
            "apology",
            "apologizes",
            "apologises",
            "open letter",
            "affair",
            "misconduct",
            "allegations"
          ],
          "decisions": [
            {
              "actor": "retail_investors",
              "decision": "pay closer attention and question their trust in management",
              "market_channel": "volume",
              "expected_direction": "up",
              "horizon": "days"
            },
            {
              "actor": "institutional_investors",
              "decision": "buy insurance against a fall while the facts are unclear",
              "market_channel": "volatility",
              "expected_direction": "up",
              "horizon": "days"
            },
            {
              "actor": "sell_side_analysts",
              "decision": "flag the risk, but mostly keep their ratings until the facts are clear",
              "market_channel": "analyst_revisions",
              "expected_direction": "uncertain",
              "horizon": "weeks"
            },
            {
              "actor": "board",
              "decision": "order an internal review",
              "horizon": "weeks"
            },
            {
              "actor": "board",
              "decision": "investigate the leader's conduct",
              "market_channel": null,
              "expected_direction": "uncertain",
              "horizon": "days"
            }
          ]
        },
        {
          "name": "leader_departure",
          "title": "Leader steps down",
          "event_types": [
            "leadership_departure"
          ],
          "follow_up_terms": [
            "steps down",
            "step down",
            "resigns",
            "resignation"
          ],
          "decisions": [
            {
              "actor": "institutional_investors",
              "decision": "rethink the investment; some sell shares",
              "market_channel": "price",
              "expected_direction": "down",
              "horizon": "days"
            },
            {
              "actor": "options_market",
              "decision": "pay more to protect against big price moves",
              "market_channel": "volatility",
              "expected_direction": "up",
              "horizon": "days"
            },
            {
              "actor": "sell_side_analysts",
              "decision": "lower ratings and price targets because the company depends on its leader",
              "market_channel": "analyst_revisions",
              "expected_direction": "down",
              "horizon": "weeks"
            },
            {
              "actor": "customers_partners",
              "decision": "review their contracts and plans with the company",
              "horizon": "weeks"
            },
            {
              "actor": "competitors",
              "decision": "try to win its staff and customers during the change",
              "market_channel": "peer_spillover",
              "expected_direction": "uncertain",
              "horizon": "weeks"
            }
          ]
        },
        {
          "name": "succession",
          "title": "New leader named",
          "event_types": [
            "leadership_appointment"
          ],
          "follow_up_terms": [
            "new CEO",
            "interim CEO",
            "successor",
            "appoints",
            "new chief executive"
          ],
          "resolves": true,
          "decisions": [
            {
              "actor": "all_investors",
              "decision": "feel less uncertain and judge the new leader",
              "market_channel": "volatility",
              "expected_direction": "down",
              "horizon": "days"
            },
            {
              "actor": "credit_investors",
              "decision": "reconsider how much extra interest to demand",
              "market_channel": "credit_spreads",
              "expected_direction": "uncertain",
              "horizon": "weeks"
            }
          ]
        }
      ]
    },
    {
      "theme": "product_safety",
      "title": "Product safety",
      "description": "Product defect escalating from recall to regulatory action to litigation.",
      "link_window_days": 90,
      "window_basis": "judgment prior",
      "window_why": "Regulator probes and lawsuits tend to follow a recall by weeks to months rather than days, so a shorter window would split one safety story into several.",
      "triggers": [
        "product_recall"
      ],
      "stages": [
        {
          "name": "recall",
          "title": "Product recall",
          "event_types": [
            "product_recall"
          ],
          "follow_up_terms": [
            "recall"
          ],
          "decisions": [
            {
              "actor": "institutional_investors",
              "decision": "estimate the cost of repairs and refunds",
              "market_channel": "price",
              "expected_direction": "down",
              "horizon": "days"
            },
            {
              "actor": "sell_side_analysts",
              "decision": "cut their profit forecasts",
              "market_channel": "analyst_revisions",
              "expected_direction": "down",
              "horizon": "weeks"
            },
            {
              "actor": "consumers",
              "decision": "delay purchases or switch to rivals",
              "horizon": "months"
            },
            {
              "actor": "competitors",
              "decision": "win customers who switch",
              "market_channel": "peer_spillover",
              "expected_direction": "up",
              "horizon": "weeks"
            }
          ]
        },
        {
          "name": "regulatory_action",
          "title": "Regulator steps in",
          "event_types": [
            "regulatory_action"
          ],
          "follow_up_terms": [
            "regulator",
            "investigation",
            "probe"
          ],
          "decisions": [
            {
              "actor": "institutional_investors",
              "decision": "expect fines and orders to fix the problem",
              "market_channel": "price",
              "expected_direction": "down",
              "horizon": "days"
            },
            {
              "actor": "credit_investors",
              "decision": "demand more interest because of possible legal costs",
              "market_channel": "credit_spreads",
              "expected_direction": "up",
              "horizon": "weeks"
            },
            {
              "actor": "options_market",
              "decision": "pay more to protect against big price moves",
              "market_channel": "volatility",
              "expected_direction": "up",
              "horizon": "days"
            }
          ]
        },
        {
          "name": "litigation",
          "title": "Lawsuit filed",
          "event_types": [
            "litigation"
          ],
          "follow_up_terms": [
            "lawsuit",
            "class action",
            "sued"
          ],
          "decisions": [
            {
              "actor": "institutional_investors",
              "decision": "set money aside for possible damages",
              "market_channel": "price",
              "expected_direction": "down",
              "horizon": "weeks"
            },
            {
              "actor": "management",
              "decision": "set money aside for legal costs, and may cut share buybacks",
              "horizon": "months"
            }
          ]
        }
      ]
    },
