    },
    {
      "theme": "m_and_a",
      "title": "Takeover / merger",
      "description": "Deal speculation to confirmed transaction.",
      "link_window_days": 90,
      "window_basis": "judgment prior",
      "window_why": "Deal rumours that become deals are typically confirmed within about a quarter; after that we treat the rumour as faded and a new report starts a new story.",
      "triggers": [
        "m_and_a_rumor",
        "m_and_a_announced"
      ],
      "stages": [
        {
          "name": "rumour",
          "title": "Takeover rumour",
          "event_types": [
            "m_and_a_rumor"
          ],
          "follow_up_terms": [
            "reportedly",
            "talks",
            "considering"
          ],
          "decisions": [
            {
              "actor": "event_driven_funds",
              "decision": "buy the potential target weighted by deal probability",
              "market_channel": "price",
              "expected_direction": "up",
              "horizon": "days"
            },
            {
              "actor": "options_market",
              "decision": "bid up short-dated calls",
              "market_channel": "volatility",
              "expected_direction": "up",
              "horizon": "days"
            }
          ]
        },
        {
          "name": "announcement",
          "title": "Takeover announced",
          "event_types": [
            "m_and_a_announced"
          ],
          "follow_up_terms": [
