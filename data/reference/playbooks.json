              "horizon": "days"
            },
            {
              "actor": "sell_side_analysts",
              "decision": "cut earnings estimates",
              "market_channel": "analyst_revisions",
              "expected_direction": "down",
              "horizon": "weeks"
            },
            {
              "actor": "consumers",
              "decision": "delay or switch purchases",
              "horizon": "months"
            },
            {
              "actor": "competitors",
              "decision": "capture switching demand",
              "market_channel": "peer_spillover",
              "expected_direction": "up",
              "horizon": "weeks"
            }
          ]
        },
        {
          "name": "regulatory_action",
          "title": "Regulator steps in",
          "event_types": [
            "regulatory_action"
          ],
          "follow_up_terms": [
            "regulator",
            "investigation",
            "probe"
          ],
          "decisions": [
            {
              "actor": "institutional_investors",
              "decision": "price in fines and remediation orders",
              "market_channel": "price",
              "expected_direction": "down",
              "horizon": "days"
            },
            {
              "actor": "credit_investors",
              "decision": "demand higher spread for legal tail risk",
              "market_channel": "credit_spreads",
              "expected_direction": "up",
              "horizon": "weeks"
            },
            {
              "actor": "options_market",
              "decision": "price outcome uncertainty",
              "market_channel": "volatility",
              "expected_direction": "up",
