      "description": "Product defect escalating from recall to regulatory action to litigation.",
      "link_window_days": 90,
      "window_basis": "judgment prior",
      "window_why": "Regulator probes and lawsuits tend to follow a recall by weeks to months rather than days, so a shorter window would split one safety story into several.",
      "triggers": [
        "product_recall"
      ],
      "stages": [
