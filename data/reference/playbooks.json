              "actor": "merger_arbitrageurs",
              "decision": "long target / short acquirer",
              "market_channel": "price",
              "expected_direction": "uncertain",
              "horizon": "weeks"
            },
            {
              "actor": "acquirer_shareholders",
              "decision": "judge overpayment risk",
              "market_channel": "price",
              "expected_direction": "down",
              "horizon": "days"
