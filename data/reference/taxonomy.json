      "patterns": ["shortage", "disruption", "halted production"]
    },
    {
      "name": "earnings_positive",
      "description": "Results or guidance above expectations",
      "patterns": ["beat", "raised its full-year", "raised guidance"]
    },
    {
      "name": "earnings_negative",
