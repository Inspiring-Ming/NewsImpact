{
  "_note": "What semantics looks for. Edit this file to add event types, aspects or word lists; no code change. Event types are checked in order, first match wins (put specific ones first). 'speculative': true/false restricts a type to hedged/unhedged sentences. Every playbook trigger must be an event type here (checked at start-up). The same file can drive an LLM analyzer's labels. 'background' words mark a sentence as history, not news (no trigger). 'attribution' says where a claim comes from, so copies and re-reports are not counted as independent confirmation.",
  "version": "taxonomy-v3",
  "event_types": [
    {
      "name": "m_and_a_rumor",
      "description": "Unconfirmed talk of a deal",
      "patterns": ["acquire", "acquisition", "merger", "takeover", "buyout"],
      "speculative": true
    },
    {
      "name": "m_and_a_announced",
      "description": "A deal is agreed or announced",
      "patterns": ["acquire", "acquisition", "merger", "takeover", "buyout"],
      "speculative": false
    },
    {
      "name": "product_recall",
      "description": "Products withdrawn for safety or quality",
      "patterns": ["recall"]
    },
    {
      "name": "leadership_departure",
