# Copy to .env for local development (git-ignored). Every variable here is read by app/config.py.
# Method settings (windows, thresholds, presets) are NOT here: see data/reference/*.json, each with its reason.
NI_ENV=local
NI_LOG_LEVEL=INFO
# demo (fictional, offline) | live (real US + ASX outlets)
NI_PROFILE=demo
# memory | sqlite (use sqlite for live monitoring)
NI_STORE=memory
NI_DB_PATH=var/newsimpact.db
# 0 = only when you click "Update now" on the website
NI_MONITOR_EVERY_MINUTES=0
# who may use the site: local = one built-in admin, no sign-in (your own computer only)
NI_AUTH=local
# how modules talk: memory (one process); cloud buses are added in app/wiring/plugins.py
NI_EVENT_BUS=memory
# keep to the outlets in data/reference/sources.json
NI_ACCEPT_UNLISTED_SOURCES=false
# SEC EDGAR requires "<app> <contact email>"
NI_HTTP_USER_AGENT=newsimpact/0.1

# Prices for the live profile: none | eodhd (US + ASX) | csv (vendor exports)
NI_MARKET_DATA=none
# secret: set in your shell or a secret store, never commit
# NI_EODHD_API_KEY=...
# <TICKER>.csv with date,adj_close,volume
NI_MARKET_CSV_DIR=var/prices

# Language model: off | quality (Claude Opus 5.5) | economy (Claude Haiku 5.5) | local (Ollama, $0)
NI_LLM_PRESET=off
NI_LLM_BASE_URL=http://localhost:11434
# all (measured best value) | candidates (fewer calls)
NI_LLM_SCOPE=all
NI_LLM_MONTHLY_BUDGET_USD=5
NI_LLM_MAX_CALLS_PER_ROUND=200
# ANTHROPIC_API_KEY is read by the Anthropic SDK itself; keep it out of this file.
# secret: put it in .env (git-ignored), never here
# ANTHROPIC_API_KEY=...

# Alerts for followed companies: a Discord incoming-webhook URL (Server settings >
# Integrations > Webhooks > New webhook > Copy webhook URL). Secret: put the real
# value only in .env, never in this file. Empty = alerts off.
NI_DISCORD_WEBHOOK_URL=
# where links in alerts point (the address people open the website at)
NI_SITE_URL=http://localhost:8000
