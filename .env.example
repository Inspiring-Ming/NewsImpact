# Copy to .env for local development (git-ignored). Every variable here is read by app/config.py.
# Method settings (windows, thresholds, presets) are NOT here: see data/reference/*.json, each with its reason.
NI_ENV=local
NI_LOG_LEVEL=INFO
NI_PROFILE=demo                      # demo (fictional, offline) | live (real US + ASX outlets)
NI_STORE=memory                      # memory | sqlite (use sqlite for live monitoring)
NI_DB_PATH=var/newsimpact.db
NI_MONITOR_EVERY_MINUTES=0           # 0 = only when you click "Run a monitoring round" on the website
NI_ACCEPT_UNLISTED_SOURCES=false     # keep to the outlets in data/reference/sources.json
NI_HTTP_USER_AGENT=newsimpact/0.1    # SEC EDGAR requires "<app> <contact email>"

# Prices for the live profile: none | eodhd (US + ASX) | csv (vendor exports)
NI_MARKET_DATA=none
# NI_EODHD_API_KEY=...               # secret: set in your shell or a secret store, never commit
NI_MARKET_CSV_DIR=var/prices         # <TICKER>.csv with date,adj_close,volume

# Language model: off | quality (Claude Opus 5.5) | economy (Claude Haiku 5.5) | local (Ollama, $0)
NI_LLM_PRESET=off
NI_LLM_BASE_URL=http://localhost:11434
NI_LLM_SCOPE=all                     # all (measured best value) | candidates (fewer calls)
NI_LLM_MONTHLY_BUDGET_USD=5
NI_LLM_MAX_CALLS_PER_ROUND=200
# ANTHROPIC_API_KEY is read by the Anthropic SDK itself; keep it out of this file.
# ANTHROPIC_API_KEY=...              # secret: put it in .env (git-ignored), never here
