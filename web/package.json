{
  "name": "newsimpact-web",
  "private": true,
  "version": "0.1.0",
  "description": "NewsImpact website - talks only to the /v1 API",
  "author": "Inspiring Ming",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:api": "openapi-typescript openapi.json -o src/api/schema.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "openapi-typescript": "7.13.0",
    "typescript": "5.6.3",
    "vite": "8.3.8"
  }
}
